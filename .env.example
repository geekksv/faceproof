# Copy to .env and fill in ONLY if you are deploying to a public testnet.
# Local development needs none of this -- the pipeline falls back to
# Hardhat's well-known dev account, which exists on every machine.

# Private key of a funded TESTNET account.
# Use a throwaway wallet. Never put a mainnet key here.
PRIVATE_KEY=

# Optional RPC overrides. Sensible public defaults are built in.
SEPOLIA_RPC_URL=
AMOY_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Set to 1 to run the search browser headless (default: visible window).
HEADLESS=0

# Optional: FaceCheck.ID token for true face-recognition search
# (--backend facecheck). Costs ~3 credits per search. Without this the free
# Yandex/Bing image-search backends are used instead.
FACECHECK_API_TOKEN=

# Free key from https://etherscan.io/myapikey (ordinary email signup, no crypto).
# Only needed to publish the contract source on Etherscan so that its
# "Read Contract" tab works and anyone can query getProof from a browser.
ETHERSCAN_API_KEY=
